#!/bin/sh
# jolta — automatic per-project JDK switching, Volta-style.
# https://github.com/dave-oneapp/jolta
set -eu

JOLTA_VERSION_STRING="0.1.0"

self=$0
n=0
while [ -L "$self" ] && [ $n -lt 32 ]; do
  t=$(readlink "$self")
  case $t in
    /*) self=$t ;;
    *)  self=$(dirname "$self")/$t ;;
  esac
  n=$((n + 1))
done
JOLTA_INSTALL_DIR=$(cd "$(dirname "$self")/.." && pwd -P)
. "$JOLTA_INSTALL_DIR/libexec/jolta-core.sh"

usage() {
  cat <<'EOF'
jolta — automatic per-project JDK switching (like Volta, for Java)

Usage: jolta <command> [args]

  setup                Install shims and add jolta to your shell profile
  pin <version>        Pin a Java version for this project (.java-version)
  default <version>    Set the global fallback Java version
  install <major>      Download and install a Temurin JDK (e.g. jolta install 21)
  uninstall <name>     Remove a jolta-managed JDK (see 'jolta list' for names)
  list, ls             List installed JDKs and where they come from
  current              Show the Java version resolved for this directory
  which [tool]         Show the full path the shim would exec (default: java)
  exec <cmd> [args]    Run a command with JAVA_HOME and PATH set for this project
  env                  Print export statements for eval in scripts
  home                 Print the resolved JAVA_HOME for this directory
  hook [zsh|bash]      Print shell hook code that keeps JAVA_HOME in sync on cd
  reshim               Regenerate shims from installed JDKs
  doctor               Diagnose common setup problems
  implode              Uninstall jolta completely (~/.jolta + shell profile lines)
  version              Print jolta's version

Version resolution order:
  JOLTA_JAVA_VERSION env var  >  nearest .java-version (walking up)  >
  jolta default  >  system default JDK
EOF
}

shims_dir()  { printf '%s/shims\n' "$(jolta_home)"; }
clear_cache() { rm -rf "$(jolta_home)/cache"; }

cmd_reshim() {
  _shims=$(shims_dir)
  mkdir -p "$_shims"
  find "$_shims" -maxdepth 1 -type l -exec rm -f {} +
  { jolta_list_managed; jolta_list_system; } | cut -f2 | sort -u | while IFS= read -r _home; do
    [ -d "$_home/bin" ] || continue
    for _bin in "$_home"/bin/*; do
      [ -x "$_bin" ] || continue
      _name=$(basename "$_bin")
      [ "$_name" = "jolta" ] && continue
      [ -e "$_shims/$_name" ] || ln -s "$JOLTA_INSTALL_DIR/libexec/jolta-shim" "$_shims/$_name"
    done
  done
  clear_cache
  printf 'jolta: %s shims in %s\n' "$(find "$_shims" -maxdepth 1 -type l | wc -l | tr -d ' ')" "$_shims"
}

profile_file() {
  case "$(basename "${SHELL:-/bin/zsh}")" in
    zsh)  printf '%s\n' "$HOME/.zshrc" ;;
    bash) if [ -f "$HOME/.bash_profile" ]; then printf '%s\n' "$HOME/.bash_profile"; else printf '%s\n' "$HOME/.bashrc"; fi ;;
    *)    printf '%s\n' "$HOME/.profile" ;;
  esac
}

cmd_setup() {
  _home=$(jolta_home)
  mkdir -p "$_home/bin" "$_home/libexec" "$_home/jdks" "$_home/cache"
  if [ "$JOLTA_INSTALL_DIR" != "$_home" ]; then
    # Install a self-contained copy so the checkout can be moved or deleted
    rm -f "$_home/bin/jolta"   # may be a symlink from an older setup
    cp "$JOLTA_INSTALL_DIR/bin/jolta" "$_home/bin/jolta"
    cp "$JOLTA_INSTALL_DIR/libexec/jolta-core.sh" "$JOLTA_INSTALL_DIR/libexec/jolta-shim" "$_home/libexec/"
    chmod +x "$_home/bin/jolta" "$_home/libexec/jolta-shim"
    printf 'jolta: installed to %s (this checkout is no longer needed at runtime)\n' "$_home"
    "$_home/bin/jolta" reshim
  else
    cmd_reshim
  fi

  _profile=$(profile_file)
  _shellname=$(basename "${SHELL:-/bin/zsh}")
  if [ -f "$_profile" ] && grep -q '>>> jolta >>>' "$_profile" 2>/dev/null; then
    printf 'jolta: PATH setup already in %s\n' "$_profile"
  else
    {
      printf '\n# >>> jolta >>>\n'
      printf 'export JOLTA_HOME="%s"\n' "\$HOME/.jolta"
      printf 'export PATH="$JOLTA_HOME/shims:$JOLTA_HOME/bin:$PATH"\n'
      printf '# <<< jolta <<<\n'
    } >> "$_profile"
    printf 'jolta: added PATH setup to %s\n' "$_profile"
  fi
  if [ -f "$_profile" ] && grep -q 'jolta hook' "$_profile" 2>/dev/null; then
    printf 'jolta: JAVA_HOME hook already in %s\n' "$_profile"
  else
    {
      printf '\n# >>> jolta hook (keeps JAVA_HOME in sync with your cwd) >>>\n'
      printf 'eval "$(jolta hook %s)"\n' "$_shellname"
      printf '# <<< jolta hook <<<\n'
    } >> "$_profile"
    printf 'jolta: added JAVA_HOME hook to %s\n' "$_profile"
  fi
  printf 'jolta: setup complete (open a new shell to activate)\n'
}

cmd_pin() {
  [ $# -ge 1 ] || jolta_die "usage: jolta pin <version>"
  _spec=$1
  if ! jolta_resolve "$_spec" >/dev/null 2>&1; then
    if [ -z "${JOLTA_NO_AUTO_INSTALL:-}" ] && command -v curl >/dev/null 2>&1; then
      printf "jolta: no installed JDK matches '%s' — fetching it now\n" "$_spec" >&2
      cmd_install "$_spec" >&2 || \
        printf "jolta: warning: install failed; pin written anyway ('jolta install %s' to retry)\n" "$_spec" >&2
    else
      printf "jolta: warning: no installed JDK currently matches '%s' ('jolta install %s' to fetch it)\n" "$_spec" "$_spec" >&2
    fi
  fi
  printf '%s\n' "$_spec" > .java-version
  printf 'jolta: pinned Java %s in %s/.java-version\n' "$_spec" "$PWD"
}

cmd_default() {
  [ $# -ge 1 ] || jolta_die "usage: jolta default <version>"
  _spec=$1
  jolta_resolve "$_spec" >/dev/null 2>&1 || \
    printf "jolta: warning: no installed JDK currently matches '%s'\n" "$_spec" >&2
  mkdir -p "$(jolta_home)"
  printf '%s\n' "$_spec" > "$(jolta_home)/default"
  printf 'jolta: default Java version set to %s\n' "$_spec"
}

cmd_list() {
  jolta_read_pin
  _current=""
  if [ -n "$JOLTA_SPEC" ]; then
    _current=$(jolta_resolve "$JOLTA_SPEC" 2>/dev/null) || _current=""
  else
    _current=$(jolta_system_default)
  fi
  printf 'jolta-managed (%s/jdks):\n' "$(jolta_home)"
  _managed=$(jolta_list_managed)
  if [ -n "$_managed" ]; then
    printf '%s\n' "$_managed" | while IFS="$(printf '\t')" read -r _v _h; do
      _mark=" "; [ "$_h" = "$_current" ] && _mark="*"
      printf '  %s %-12s %s\n' "$_mark" "$_v" "$_h"
    done
  else
    printf '   (none — use "jolta install <major>")\n'
  fi
  printf 'system:\n'
  jolta_list_system | sort -u | while IFS="$(printf '\t')" read -r _v _h; do
    _mark=" "; [ "$_h" = "$_current" ] && _mark="*"
    printf '  %s %-12s %s\n' "$_mark" "$_v" "$_h"
  done
  if [ -n "$JOLTA_SPEC" ]; then
    printf '\n* = active here (pinned '\''%s'\'' by %s)\n' "$JOLTA_SPEC" "$JOLTA_SPEC_SOURCE"
  else
    printf '\n* = active here (system default; nothing pinned)\n'
  fi
}

cmd_current() {
  jolta_resolve_current
  _v=$(jolta_jdk_version "$JOLTA_RESOLVED_HOME" 2>/dev/null) || _v="unknown"
  printf '%s (from %s)\n' "$_v" "$JOLTA_SPEC_SOURCE"
  printf '%s\n' "$JOLTA_RESOLVED_HOME"
}

cmd_which() {
  _tool=${1:-java}
  jolta_resolve_current
  [ -x "$JOLTA_RESOLVED_HOME/bin/$_tool" ] || jolta_die "'$_tool' not found in $JOLTA_RESOLVED_HOME"
  printf '%s/bin/%s\n' "$JOLTA_RESOLVED_HOME" "$_tool"
}

cmd_exec() {
  [ $# -ge 1 ] || jolta_die "usage: jolta exec <command> [args...]"
  JOLTA_AUTO_INSTALL=1 JOLTA_CLI="$JOLTA_INSTALL_DIR/bin/jolta"
  jolta_resolve_current
  JAVA_HOME=$JOLTA_RESOLVED_HOME
  PATH="$JOLTA_RESOLVED_HOME/bin:$PATH"
  export JAVA_HOME PATH
  exec "$@"
}

cmd_env() {
  JOLTA_AUTO_INSTALL=1 JOLTA_CLI="$JOLTA_INSTALL_DIR/bin/jolta"
  jolta_resolve_current
  printf 'export JAVA_HOME="%s"\n' "$JOLTA_RESOLVED_HOME"
  printf 'export PATH="%s/bin:$PATH"\n' "$JOLTA_RESOLVED_HOME"
}

cmd_home() {
  jolta_resolve_current
  printf '%s\n' "$JOLTA_RESOLVED_HOME"
}

cmd_hook() {
  _shell=${1:-$(basename "${SHELL:-/bin/zsh}")}
  case $_shell in
    zsh) cat <<'EOF'
_jolta_update_java_home() {
  local _jh
  if _jh=$(jolta home 2>/dev/null); then
    export JAVA_HOME=$_jh
  else
    unset JAVA_HOME
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _jolta_update_java_home
_jolta_update_java_home
EOF
      ;;
    bash) cat <<'EOF'
_jolta_update_java_home() {
  if [ "${_JOLTA_LAST_PWD:-}" = "$PWD" ]; then return; fi
  _JOLTA_LAST_PWD=$PWD
  local _jh
  if _jh=$(jolta home 2>/dev/null); then
    export JAVA_HOME=$_jh
  else
    unset JAVA_HOME
  fi
}
case ";$PROMPT_COMMAND;" in
  *";_jolta_update_java_home;"*) ;;
  *) PROMPT_COMMAND="_jolta_update_java_home${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac
_jolta_update_java_home
EOF
      ;;
    *) jolta_die "no hook available for shell '$_shell' (zsh and bash are supported)" ;;
  esac
}

cmd_install() {
  [ $# -ge 1 ] || jolta_die "usage: jolta install <major>  (e.g. jolta install 21)"
  _major=$(jolta_major_of "$1")
  [ -n "$_major" ] || jolta_die "cannot parse version '$1'"

  case "$(uname -s)" in
    Darwin) _os=mac ;;
    Linux)  _os=linux ;;
    *) jolta_die "unsupported OS: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) _arch=aarch64 ;;
    x86_64)        _arch=x64 ;;
    *) jolta_die "unsupported architecture: $(uname -m)" ;;
  esac

  # Serialize concurrent installs of the same major (parallel builds can fire
  # several shims at once); whoever loses the race waits, then re-checks.
  mkdir -p "$(jolta_home)/cache"
  _lock="$(jolta_home)/cache/install-$_major.lock"
  if ! mkdir "$_lock" 2>/dev/null; then
    printf 'jolta: another install of Temurin %s is running; waiting...\n' "$_major"
    _waited=0
    while [ -d "$_lock" ] && [ $_waited -lt 600 ]; do sleep 2; _waited=$((_waited + 2)); done
    if jolta_resolve "$_major" >/dev/null 2>&1; then
      printf 'jolta: Temurin %s installed by the other process\n' "$_major"
      return 0
    fi
    [ -d "$_lock" ] && jolta_die "timed out waiting for concurrent install (remove $_lock if stale)"
    mkdir "$_lock" 2>/dev/null || jolta_die "could not acquire install lock $_lock"
  fi

  _url="https://api.adoptium.net/v3/binary/latest/${_major}/ga/${_os}/${_arch}/jdk/hotspot/normal/eclipse"
  _tmp=$(mktemp -d "${TMPDIR:-/tmp}/jolta-install.XXXXXX")
  trap 'rm -rf "$_tmp" "$_lock"' EXIT INT TERM

  printf 'jolta: downloading Temurin %s (%s/%s) from Adoptium...\n' "$_major" "$_os" "$_arch"
  curl -fSL --progress-bar -o "$_tmp/jdk.tar.gz" "$_url" || \
    jolta_die "download failed — is Temurin $_major published for $_os/$_arch? ($_url)"

  printf 'jolta: extracting...\n'
  mkdir -p "$_tmp/x"
  tar -xzf "$_tmp/jdk.tar.gz" -C "$_tmp/x"
  _top=$(find "$_tmp/x" -mindepth 1 -maxdepth 1 -type d | head -n1)
  [ -n "$_top" ] || jolta_die "unexpected archive layout"

  _h=$(jolta_managed_home "$_top")
  _full=$(jolta_jdk_version "$_h") || jolta_die "no release file in extracted JDK"

  _dest="$(jolta_home)/jdks/temurin-$_full"
  if [ -d "$_dest" ]; then
    printf 'jolta: Temurin %s is already installed\n' "$_full"
  else
    mkdir -p "$(jolta_home)/jdks"
    mv "$_top" "$_dest"
    printf 'jolta: installed Temurin %s -> %s\n' "$_full" "$_dest"
  fi
  cmd_reshim
}

cmd_uninstall() {
  [ $# -ge 1 ] || jolta_die "usage: jolta uninstall <name>  (a directory name from $(jolta_home)/jdks)"
  _dest="$(jolta_home)/jdks/$1"
  [ -d "$_dest" ] || jolta_die "'$1' is not a jolta-managed JDK (see 'jolta list')"
  rm -rf "$_dest"
  clear_cache
  printf 'jolta: removed %s\n' "$_dest"
}

cmd_implode() {
  _home=$(jolta_home)
  _profile=$(profile_file)
  if [ "${1:-}" != "--yes" ]; then
    printf 'This removes %s (including downloaded JDKs) and the jolta lines from %s.\n' "$_home" "$_profile"
    printf 'Type "yes" to continue: '
    read -r _answer
    [ "$_answer" = "yes" ] || jolta_die "aborted"
  fi
  if [ -f "$_profile" ]; then
    _tmp="$_profile.jolta-implode.$$"
    sed -e '/# >>> jolta hook/,/# <<< jolta hook <<</d' \
        -e '/# >>> jolta >>>/,/# <<< jolta <<</d' "$_profile" > "$_tmp"
    mv "$_tmp" "$_profile"
    printf 'jolta: removed jolta lines from %s\n' "$_profile"
  fi
  rm -rf "$_home"
  printf 'jolta: removed %s — open a new shell to finish. So long!\n' "$_home"
}

cmd_doctor() {
  _ok=0
  _home=$(jolta_home)
  printf 'jolta doctor\n'
  printf '  jolta home:    %s\n' "$_home"
  printf '  install dir:   %s\n' "$JOLTA_INSTALL_DIR"

  if [ -d "$_home/shims" ] && [ -n "$(find "$_home/shims" -maxdepth 1 -type l 2>/dev/null | head -n1)" ]; then
    printf '  shims:         ok (%s installed)\n' "$(find "$_home/shims" -maxdepth 1 -type l | wc -l | tr -d ' ')"
  else
    printf '  shims:         MISSING — run "jolta setup"\n'; _ok=1
  fi

  case ":$PATH:" in
    *":$_home/shims:"*) printf '  PATH:          ok (shims dir is on PATH)\n' ;;
    *) printf '  PATH:          shims dir NOT on PATH — run "jolta setup" and open a new shell\n'; _ok=1 ;;
  esac

  _java=$(command -v java 2>/dev/null || true)
  case "$_java" in
    "$_home/shims/"*) printf '  java:          ok (resolves to the jolta shim)\n' ;;
    "") printf '  java:          not found on PATH\n'; _ok=1 ;;
    *)  printf '  java:          BYPASSING jolta (%s comes before the shims on PATH)\n' "$_java"; _ok=1 ;;
  esac

  _expected=$(cmd_home 2>/dev/null) || _expected=""
  if [ -n "${JAVA_HOME:-}" ]; then
    if [ "$JAVA_HOME" = "$_expected" ]; then
      printf '  JAVA_HOME:     ok (%s — matches the pin here, hook is working)\n' "$JAVA_HOME"
    else
      printf '  JAVA_HOME:     STALE: %s\n' "$JAVA_HOME"
      printf '                 expected %s for this directory\n' "${_expected:-<unresolvable>}"
      printf '                 mvn/gradle use JAVA_HOME directly and will bypass jolta;\n'
      printf '                 remove any manual "export JAVA_HOME" from your shell profile\n'
      printf '                 and make sure the jolta hook line comes after it ("jolta setup" adds it)\n'
      _ok=1
    fi
  else
    printf '  JAVA_HOME:     not set — shims still work, but mvn/gradle prefer JAVA_HOME;\n'
    printf '                 run "jolta setup" to install the cd hook that keeps it in sync\n'
  fi

  _count=$( { jolta_list_managed; jolta_list_system; } | wc -l | tr -d ' ')
  printf '  JDKs found:    %s\n' "$_count"
  [ "$_count" -gt 0 ] || { printf '                 none! install one with "jolta install 21"\n'; _ok=1; }

  jolta_read_pin
  if [ -n "$JOLTA_SPEC" ]; then
    printf "  pin here:      '%s' via %s\n" "$JOLTA_SPEC" "$JOLTA_SPEC_SOURCE"
  else
    printf '  pin here:      none (system default JDK will be used)\n'
  fi
  exit $_ok
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  setup)          cmd_setup "$@" ;;
  pin)            cmd_pin "$@" ;;
  default)        cmd_default "$@" ;;
  install)        cmd_install "$@" ;;
  uninstall)      cmd_uninstall "$@" ;;
  list|ls)        cmd_list "$@" ;;
  current)        cmd_current "$@" ;;
  which)          cmd_which "$@" ;;
  exec)           cmd_exec "$@" ;;
  env)            cmd_env "$@" ;;
  home)           cmd_home "$@" ;;
  hook)           cmd_hook "$@" ;;
  reshim)         cmd_reshim "$@" ;;
  implode)        cmd_implode "$@" ;;
  doctor)         cmd_doctor "$@" ;;
  version|-v|--version) printf 'jolta %s\n' "$JOLTA_VERSION_STRING" ;;
  help|-h|--help) usage ;;
  *) usage >&2; jolta_die "unknown command '$cmd'" ;;
esac
